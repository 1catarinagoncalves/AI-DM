{
  "name": "@ai-dm/ai-engine",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "eval": "vitest run --config vitest.eval.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@ai-dm/shared": "workspace:*",
    "@ai-sdk/google": "^4.0.31",
    "@ai-sdk/groq": "^4.0.19",
    "@ai-sdk/openai-compatible": "^3.0.20",
    "ai": "^7.0.48",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
