generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String      @id @default(cuid())
  email              String      @unique
  name               String
  // US-97: idioma ativo da conta ('pt-BR' | 'en-US'). Preferência MUTÁVEL (ADR 005 D1):
  // aplica ao conteúdo futuro (UI, narração nova, abertura); nada já gravado é reescrito.
  locale             String      @default("pt-BR")
  characters         Character[]
  createdAdventures  Adventure[] @relation("AdventureCreator")
  createdAt          DateTime    @default(now())
}

model Character {
  id             String                 @id @default(cuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id])
  systemId       String
  system         System                 @relation(fields: [systemId], references: [id])
  name           String
  gender         String
  race           String
  class          String
  level          Int                    @default(1)
  baseAttributes Json
  skills         Json                   @default("[]") // US-27: keys de perícia proficientes (string[])
  features       Json                   @default("[]") // US-41: features de classe de nível 1 ({name, description}[])
  spells         Json                   @default("[]") // US-42: magias conhecidas ({name, level?, description?}[])
  background     Json                   @default("{}") // US-39/US-40: {story?, ideals?, bonds?, flaws?, deity?:{name,portfolio?}}
  states         CharacterState[]
  participations AdventureParticipant[]
  eventLogs      EventLog[]
  createdAt      DateTime               @default(now())
}

model CharacterState {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  adventureId String
  adventure   Adventure @relation(fields: [adventureId], references: [id])
  hp          Int
  maxHp       Int
  attributes  Json
  inventory   Json      @default("[]")
  conditions  Json      @default("[]")
  sceneState  Json?
  updatedAt   DateTime  @updatedAt

  @@unique([characterId, adventureId])
}

model Adventure {
  id              String                 @id @default(cuid())
  systemId        String
  system          System                 @relation(fields: [systemId], references: [id])
  creatorId       String
  creator         User                   @relation("AdventureCreator", fields: [creatorId], references: [id])
  title           String
  order           Int
  status          AdventureStatus        @default(ACTIVE)
  memorySummary   String?
  // Registro estruturado de entidades duráveis da campanha (NPCs, locais, objetos
  // notáveis). Vive FORA do EventLog/resumo: nunca é comprimido nem apagado pela
  // sumarização, então um callback a uma entidade de muitos turnos atrás (ex.: "a
  // Vigia na sala secreta") sobrevive. Array de WorldEntity (@ai-dm/shared).
  entities        Json?
  participants    AdventureParticipant[]
  characterStates CharacterState[]
  quests          Quest[]
  eventLogs       EventLog[]
  createdAt       DateTime               @default(now())
  completedAt     DateTime?
}

model AdventureParticipant {
  id          String    @id @default(cuid())
  adventureId String
  adventure   Adventure @relation(fields: [adventureId], references: [id])
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  joinedAt    DateTime  @default(now())

  @@unique([adventureId, characterId])
}

enum AdventureStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Quest {
  id          String      @id @default(cuid())
  adventureId String
  adventure   Adventure   @relation(fields: [adventureId], references: [id])
  title       String
  description String
  status      QuestStatus @default(OPEN)
  isPrimary   Boolean     @default(false)
  completedAt DateTime?
}

enum QuestStatus {
  OPEN
  COMPLETED
  FAILED
}

model EventLog {
  id          String    @id @default(cuid())
  adventureId String
  adventure   Adventure @relation(fields: [adventureId], references: [id])
  characterId String?
  character   Character? @relation(fields: [characterId], references: [id])
  type        EventType
  payload     Json
  // Marca turnos (ACTION/NARRATION) já incorporados ao Adventure.memorySummary.
  // Histórico não-resumido é o que vai verbatim para o agente a cada turno.
  summarized  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([adventureId, characterId, type, summarized])
}

enum EventType {
  ACTION
  NARRATION
  DICE_ROLL
  QUEST_UPDATE
  CHARACTER_UPDATE
}

model System {
  id         String      @id @default(cuid())
  name       String
  version    String
  sourceType SourceType
  ragIndexId String?
  // Atributos + kits iniciais (ADR 003, D1). Validado por SystemConfigSchema em @ai-dm/shared.
  // US-99: esta é a BASE EN (dataset SRD cru, sem overlay). `en-US` nunca tem entrada
  // em configLocales — é esta coluna.
  config     Json?
  // US-99: mapa `locale → SystemConfig` LOCALIZADO e completo (ADR 005: locale é dimensão
  // de leitura, não linha nova de System). Leitura: configLocales[user.locale] ?? config.
  configLocales Json @default("{}")
  adventures Adventure[]
  characters Character[]
}

enum SourceType {
  FREE
  SRD
  UPLOAD
}
