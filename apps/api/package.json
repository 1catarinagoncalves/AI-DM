{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "test": "vitest run",
    "test:int": "vitest run -c vitest.int.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "db:migrate:race-class": "ts-node prisma/migrate-race-class-keys.ts",
    "db:migrate:feature-spell": "ts-node prisma/migrate-feature-spell-keys.ts"
  },
  "dependencies": {
    "@ai-dm/ai-engine": "workspace:*",
    "@ai-dm/shared": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "ai": "^7.0.84",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.3",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.10",
    "vitest": "^3.2.4"
  }
}
