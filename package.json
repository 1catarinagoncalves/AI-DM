{
  "name": "ai-dm",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "dotenv -e .env -- pnpm --parallel --filter api --filter web dev",
    "build": "pnpm --fail-if-no-match --filter \"./packages/*\" build && pnpm --fail-if-no-match --filter \"./apps/*\" build",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "test:int": "pnpm --fail-if-no-match --filter api test:int",
    "eval": "pnpm --fail-if-no-match --filter ai-engine eval",
    "db:migrate": "dotenv -e .env -- pnpm --fail-if-no-match --filter api db:migrate",
    "db:studio": "dotenv -e .env -- pnpm --fail-if-no-match --filter api db:studio",
    "db:seed": "dotenv -e .env -- pnpm --fail-if-no-match --filter api db:seed",
    "db:migrate:race-class": "dotenv -e .env -- pnpm --fail-if-no-match --filter api db:migrate:race-class",
    "db:migrate:feature-spell": "dotenv -e .env -- pnpm --fail-if-no-match --filter api db:migrate:feature-spell",
    "dead": "knip",
    "docs:links": "node scripts/check-doc-links.mjs",
    "docs:links:test": "node --test scripts/check-doc-links.test.mjs",
    "docs:shape": "node --test scripts/readme-shape.test.mjs",
    "i18n:literals": "node scripts/check-jsx-literals.mjs",
    "i18n:literals:test": "node --test scripts/check-jsx-literals.test.mjs",
    "srd:sync": "node scripts/srd/sync.mjs",
    "srd:ingest": "pnpm --fail-if-no-match --filter @ai-dm/ai-engine... build && dotenv -e .env -- node scripts/srd/ingest.mjs",
    "srd:ingest:test": "node --test scripts/srd/ingest.test.mjs"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "knip": "^6.32.0",
    "typescript": "^7.0.2"
  }
}
