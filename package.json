{
  "name": "ai-dm",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "build": "pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "eval": "pnpm --filter ai-engine eval",
    "db:migrate": "dotenv -e .env -- pnpm --filter api db:migrate",
    "db:studio": "dotenv -e .env -- pnpm --filter api db:studio",
    "db:seed": "dotenv -e .env -- pnpm --filter api db:seed",
    "srd:sync": "node scripts/srd/sync.mjs",
    "srd:ingest": "pnpm --filter @ai-dm/shared build && node scripts/srd/ingest.mjs"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.8.3"
  }
}
